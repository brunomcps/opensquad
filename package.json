{
  "name": "opensquad-content-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=../../.env server/index.ts\" \"vite\"",
    "dev:server": "tsx watch --env-file=../../.env server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "start": "NODE_ENV=production tsx server/index.ts",
    "local-start": "vite build && tsx --env-file=../../.env server/index.ts",
    "preview": "vite preview",
    "ci:migrate": "tsx server/scripts/commercial-intelligence/apply-migration.ts",
    "push-remote": "tsx --env-file=../.env server/scripts/push-to-remote.ts",
    "test": "node --import tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@types/node-cron": "^3.0.11",
    "chokidar": "^5.0.0",
    "csv-parse": "^6.2.1",
    "express": "^5.1.0",
    "googleapis": "^144.0.0",
    "node-cron": "^4.2.1",
    "playwright-core": "^1.58.2",
    "postgres": "^3.4.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
