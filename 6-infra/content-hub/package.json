{
  "name": "opensquad-content-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch --env-file=../../.env server/index.ts\" \"vite\"",
    "dev:server": "tsx watch --env-file=../../.env server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "start": "NODE_ENV=production tsx server/index.ts",
    "local-start": "vite build && tsx --env-file=../../.env server/index.ts",
    "preview": "vite preview",
    "ci:dev:web": "vite --config vite.ci.config.ts",
    "ci:build:web": "vite build --config vite.ci.config.ts",
    "ci:preview:web": "vite preview --config vite.ci.config.ts",
    "ci:verify-bundle": "tsx server/scripts/commercial-intelligence/verify-ci-bundle.ts",
    "ci:smoke:visual": "tsx server/scripts/commercial-intelligence/visual-smoke.ts",
    "ci:smoke:overview": "tsx server/scripts/commercial-intelligence/visual-overview-smoke.ts",
    "ci:smoke:decisions": "tsx server/scripts/commercial-intelligence/visual-decision-smoke.ts",
    "ci:smoke:stories": "tsx server/scripts/commercial-intelligence/visual-story-content-smoke.ts",
    "ci:smoke:overview:production": "tsx server/scripts/commercial-intelligence/production-overview-smoke.ts",
    "ci:smoke:decisions:production": "tsx server/scripts/commercial-intelligence/production-decision-smoke.ts",
    "ci:smoke:tracking:production": "tsx server/scripts/commercial-intelligence/production-tracking-control-smoke.ts",
    "ci:pilot:mapa7p": "tsx server/scripts/commercial-intelligence/create-mapa7p-pilot.ts",
    "ci:catalog:mapa7p": "tsx server/scripts/commercial-intelligence/create-mapa7p-catalog.ts",
    "ci:audit:youtube-links": "tsx server/scripts/commercial-intelligence/audit-youtube-mapa7p-links.ts",
    "ci:apply:youtube-links": "tsx server/scripts/commercial-intelligence/apply-youtube-mapa7p-links.ts",
    "ci:validate:decisions": "tsx server/scripts/commercial-intelligence/validate-decision-data.ts",
    "ci:check:edge": "npx --yes deno@2.5.6 check supabase/functions/ci-quality/index.ts supabase/functions/ci-overview/index.ts supabase/functions/ci-hotmart-webhook/index.ts supabase/functions/ci-sync-hotmart/index.ts supabase/functions/ci-sync-youtube/index.ts supabase/functions/ci-campaigns/index.ts supabase/functions/ci-attribution/index.ts supabase/functions/ci-association/index.ts supabase/functions/ci-campaign-redirect/index.ts supabase/functions/ci-tracking-series/index.ts supabase/functions/ci-tracking-events/index.ts supabase/functions/ci-content/index.ts",
    "ci:check": "npm test && npm run typecheck && npm run ci:build:web && npm run ci:verify-bundle && npm run ci:check:edge",
    "ci:migrate": "tsx server/scripts/commercial-intelligence/apply-migration.ts",
    "ci:sync": "tsx server/scripts/commercial-intelligence/run-initial-sync.ts",
    "push-remote": "tsx --env-file=../.env server/scripts/push-to-remote.ts",
    "test": "node --import tsx --test \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@types/node-cron": "^3.0.11",
    "chokidar": "^5.0.0",
    "csv-parse": "^6.2.1",
    "express": "^5.1.0",
    "googleapis": "^144.0.0",
    "marked": "^12.0.2",
    "node-cron": "^4.2.1",
    "playwright-core": "^1.58.2",
    "postgres": "^3.4.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/express": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
